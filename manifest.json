{
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_icon": "img/icon.png",
    "default_title": "Ruxget",
    "default_popup": "shiying.html"
  },
  "side_panel": {
    "default_path": "shiying.html"
  },
  "description": "免费开源、无广告的中文视频下载助手，支持 B站和 YouTube 清晰度选择、完整 MP4 与单独 MP3 下载。",
  "icons": {
    "64": "/img/icon.png",
    "128": "/img/icon128.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Ruxget · Web Video Downloader",
  "homepage_url": "https://github.com/hesay77-cmyk/shiying",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "storage",
    "webNavigation",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "offscreen",
    "sidePanel",
    "contextMenus",
    "activeTab"
  ],
  "commands": {
    "_execute_action": {},
    "enable": {
      "description": "__MSG_pause__ / __MSG_enable__"
    },
    "auto_down": {
      "description": "__MSG_autoDownload__"
    },
    "catch": {
      "description": "__MSG_cacheCapture__"
    },
    "m3u8": {
      "description": "__MSG_m3u8Parser__"
    },
    "clear": {
      "description": "__MSG_clear__"
    },
    "reboot": {
      "description": "__MSG_restartExtension__"
    },
    "deepSearch": {
      "description": "__MSG_deepSearch__"
    },
    "preview": {
      "description": "__MSG_preview__"
    }
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*",
    "https://*.googlevideo.com/*",
    "https://www.bilibili.com/*",
    "https://bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*",
        "https://youtu.be/*",
        "https://www.bilibili.com/*",
        "https://bilibili.com/*"
      ],
      "js": [
        "js/content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*",
        "https://www.bilibili.com/*",
        "https://bilibili.com/*"
      ],
      "js": [
        "js/shiying-locale.js",
        "js/shiying-floating.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "default_locale": "zh_CN",
  "version": "0.4.42",
  "version_name": "0.4.42 desktop-connection-recovery",
  "optional_permissions": [
    "nativeMessaging",
    "cookies"
  ],
  "incognito": "split",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "_locales/en/messages.json",
        "_locales/zh_CN/messages.json"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*",
        "https://youtu.be/*",
        "https://www.bilibili.com/*",
        "https://bilibili.com/*"
      ]
    }
  ]
}

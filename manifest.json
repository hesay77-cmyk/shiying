{
  "background": {
    "service_worker": "js/ruxget-background.js"
  },
  "action": {
    "default_icon": {
      "16": "img/icon16.png",
      "32": "img/icon32.png"
    },
    "default_title": "Ruxget",
    "default_popup": "shiying.html"
  },
  "side_panel": {
    "default_path": "shiying.html"
  },
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "/img/icon16.png",
    "32": "/img/icon32.png",
    "48": "/img/icon48.png",
    "64": "/img/icon.png",
    "128": "/img/icon128.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "__MSG_extName__",
  "homepage_url": "https://github.com/hesay77-cmyk/shiying",
  "options_ui": {
    "page": "ruxget-settings.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "downloads.ui",
    "storage",
    "webNavigation",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "offscreen",
    "sidePanel",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://bilibili.com/*"
      ],
      "js": [
        "js/shiying-locale.js",
        "js/shiying-text.js",
        "js/shiying-floating.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "default_locale": "zh_CN",
  "version": "0.4.78",
  "version_name": "0.4.78",
  "optional_permissions": [
    "nativeMessaging",
    "downloads.open",
    "cookies"
  ],
  "incognito": "split",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "_locales/en/messages.json",
        "_locales/zh_CN/messages.json"
      ],
      "matches": [
        "https://www.bilibili.com/*",
        "https://bilibili.com/*"
      ]
    }
  ]
}
